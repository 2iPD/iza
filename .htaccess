RewriteEngine On
RewriteBase /

# QUIZ ADV: URLs públicas sem alterar as páginas existentes.
RewriteRule ^(quiz-[1-9][0-9]{0,8})/?$ /quiz-adv/player.php?slug=$1 [L]

# Redirecionar / para /treinamento-maria-da-penha (opcional) ou reescrever a rota
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^treinamento-maria-da-penha/?$ /index.html [L,QSA]

